# Конфигурация для обучения ANFIS модели восстановления спектра нейтронов

dataset:
  # Пути к данным
  train_data: "normalized_linear_data_with_q_500K.csv"
  validation_data: "normalized_data_with_q_375.csv"
  
  # Параметры данных
  normalize_sum: true  # Нормализация на SUM (как предложил Юра)
  test_size: 0.25
  random_state: 42

model:
  # Параметры ANFIS модели
  num_rules: 10  # Количество нечетких правил
  mf_class: "Gaussian"  # Тип функций принадлежности: Gaussian, GBell, Triangular
  optim: "OriginalPSO"  # Алгоритм оптимизации: OriginalPSO, PSO, GA, ...
  reg_lambda: 0.1  # Коэффициент L2-регуляризации
  seed: 42  # Seed для воспроизводимости
  n_workers: 4  # Количество потоков для параллельных вычислений
  
  # Параметры оптимизатора PSO
  optim_params:
    epoch: 20  # Количество эпох обучения PSO
    pop_size: 30  # Размер популяции
    verbose: true  # Выводить ли информацию о процессе PSO

# Параметры SHAP-регуляризации (опционально)
shap_reg:
  enabled: false  # Использовать ли SHAP-регуляризацию
  gamma: 0.5  # Коэффициент SHAP-регуляризации
  epochs: 25  # Количество эпох для SHAP-регуляризации
  batch_size: 32  # Размер батча
  lr: 0.005  # Скорость обучения

# Пути для сохранения результатов
output:
  results_dir: "results"
  save_model: true  # Сохранять ли обученную модель
  save_predictions: true  # Сохранять ли предсказания
  save_plots: true  # Сохранять ли графики

